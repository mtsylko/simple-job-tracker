{
  "name": "job-tracker-api",
  "version": "1.0.0",
  "description": "Job tracker API service",
  "main": "../dist/main.js",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "yarn workspace @job-tracker/shared build && ../node_modules/.bin/tsc && node scripts/copy-prompts.mjs",
    "start": "node dist/main.js",
    "test": "../node_modules/.bin/vitest run",
    "clean": "node -e \"require('fs').rmSync('../dist',{recursive:true,force:true})\"",
    "typeorm": "../node_modules/.bin/typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "yarn typeorm migration:generate",
    "migration:create": "../node_modules/.bin/typeorm-ts-node-commonjs migration:create",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "lint": "node ../node_modules/.bin/eslint src test && node ../node_modules/.bin/prettier --check \"{src,test}/**/*.ts\"",
    "lint:fix": "node ../node_modules/.bin/eslint src test --fix && node ../node_modules/.bin/prettier --write \"{src,test}/**/*.ts\""
  },
  "author": "Maxim Tsylko",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@job-tracker/shared": "workspace:*",
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "zod": "^4.3.6"
  }
}
