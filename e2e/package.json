{
  "name": "job-tracker-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Browser tests of the main flow, against a throwaway API and database",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "compile": "yarn workspace @job-tracker/shared build && ../node_modules/.bin/tsc --noEmit",
    "lint": "node ../node_modules/.bin/eslint . && node ../node_modules/.bin/prettier --check \"**/*.{ts,mjs}\"",
    "lint:fix": "node ../node_modules/.bin/eslint . --fix && node ../node_modules/.bin/prettier --write \"**/*.{ts,mjs}\""
  },
  "author": "Maxim Tsylko",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "pg": "^8.16.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
